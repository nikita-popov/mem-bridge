[Unit]
Description=mem-bridge MCP HTTP bridge
After=network.target

[Service]
Type=simple
User=mem-bridge
Group=mem-bridge
WorkingDirectory=/opt/mem-bridge
EnvironmentFile=-/etc/mem-bridge/env
ExecStart=/opt/mem-bridge/venv/bin/uvicorn server:app \
    --host 127.0.0.1 \
    --port 8765 \
    --no-access-log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
