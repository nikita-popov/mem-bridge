# Copy to .env and adjust values, or set these as environment variables.
# All variables are optional; shown with defaults.

# Path to the MemPalace palace directory.
# Leave empty to use MemPalace's own default (~/.mempalace/palace).
MEMBRIDGE_PALACE_PATH=

# Path to the mempalace binary.
# Uses whatever is on PATH if left as "mempalace".
MEMBRIDGE_MEMPALACE_BIN=mempalace

# File containing bearer tokens (one per line, # comments allowed).
MEMBRIDGE_TOKENS_FILE=/etc/mem-bridge/tokens

# Gunicorn bind address.
MEMBRIDGE_BIND=127.0.0.1:8765

# Number of gunicorn workers.
# Keep at 1 if MemPalace uses SQLite to avoid write contention.
MEMBRIDGE_WORKERS=1

# Comma-separated list of external hostnames allowed to connect via MCP.
# FastMCP blocks non-localhost hosts by default (DNS rebinding protection).
# Set this to the public hostname served by your reverse proxy.
# Use "*" to disable the check entirely (not recommended on public servers).
#
# Example:
#   MEMBRIDGE_ALLOWED_HOSTS=chat.example.com
MEMBRIDGE_ALLOWED_HOSTS=
