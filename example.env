# Copy to .env and adjust, or set as systemd EnvironmentFile=.
# All variables are optional; defaults are shown.

# Shell command to launch the MemPalace MCP stdio server.
# Must be the python that has mempalace installed.
MEMBRIDGE_MEMPALACE_CMD=python -m mempalace.mcp_server

# Optional: path to the MemPalace palace directory.
# Set if you need to override the default (~/.mempalace/palace).
# Export it so the subprocess inherits it.
# MEMPALACE_PALACE_PATH=/opt/chatd/.mempalace/palace

# File containing bearer tokens (one per line, # = comment).
# If the file is missing auth is DISABLED (dev mode).
MEMBRIDGE_TOKENS_FILE=/etc/mem-bridge/tokens

# Comma-separated external hostnames allowed to connect via MCP.
# FastMCP blocks non-localhost hosts by default (DNS rebinding protection).
# Set to your reverse-proxy hostname, e.g.: chat.example.com
# Use "*" to disable the check entirely (not recommended).
MEMBRIDGE_ALLOWED_HOSTS=

# Timeouts (seconds)
MEMBRIDGE_LIST_TOOLS_TIMEOUT=30
MEMBRIDGE_CALL_TOOL_TIMEOUT=60
